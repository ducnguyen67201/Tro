{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tro",
  "version": "0.1.0",
  "identifier": "vn.tro.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Tro — Trợ lý học tập",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "confirmation",
        "title": "Tro cần xác nhận",
        "width": 590,
        "height": 330,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Vietnamese-first desktop learning assistant",
    "longDescription": "Tro helps invited Vietnamese university students understand work on their screen through voice, visual guidance, dictation, and guarded computer use.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.2"
    },
    "windows": { "wix": { "language": ["en-US"] } }
  },
  "plugins": { "updater": { "active": false, "endpoints": [] } }
}
