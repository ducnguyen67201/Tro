DATABASE_URL=
# Optional unless realtime is enabled or COMPUTER_PROVIDER=openai_responses is active.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_COMPUTER_MODEL=gpt-5.6
OPENAI_REALTIME_VOICE=
# openai_responses or openrouter_chat
COMPUTER_PROVIDER=openrouter_chat
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_COMPUTER_MODEL=google/gemini-2.5-flash
TUTOR_TIMEOUT_SECONDS=20
TUTOR_AUDIO_MAX_BYTES=3145728
TUTOR_ENABLED=true
# Development only: allowed only with DATABASE_URL=memory:// and loopback BIND_ADDR.
TRO_DEVICE_TOKEN=
# Development only: maps a local invite to TRO_DEVICE_TOKEN on a loopback memory backend.
TRO_DEVELOPMENT_INVITE_CODE=
DEVICE_TOKEN_HMAC_KEY=
INVITE_CODE_PEPPER=
# Google Cloud OAuth client with application type "Desktop app".
GOOGLE_OAUTH_CLIENT_ID=
# Optional for Google Desktop app clients.
GOOGLE_OAUTH_CLIENT_SECRET=
AGENT_CONTINUATION_AEAD_KEY=
BIND_ADDR=127.0.0.1:8080
SCREENSHOT_MAX_BYTES=6291456
SCREENSHOT_MAX_EDGE_PX=3840
AGENT_MAX_TURNS=20
AGENT_MAX_ACTIONS=100
AGENT_MAX_SECONDS=300
DEVICE_DAILY_REALTIME_SECONDS=3600
DEVICE_DAILY_SCREENSHOTS=200
DEVICE_DAILY_AGENT_TURNS=100
AGENT_ENABLED=false
RELIABLE_COMPUTER_USE_ENABLED=false
REALTIME_ENABLED=false
LOG_FORMAT=json

# Example candidates only; copy them into the variables above after a release canary.
# OPENAI_REALTIME_MODEL example: gpt-realtime-2.1
# OPENAI_COMPUTER_MODEL example: gpt-5.6
