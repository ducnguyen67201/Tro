{
  "name": "tro-marketing",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tro/landing dev",
    "start": "pnpm --filter @tro/landing start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps/landing/src apps/landing/*.ts",
    "typecheck": "pnpm --filter @tro/landing typecheck",
    "build": "pnpm --filter @tro/landing build",
    "test": "pnpm --filter @tro/landing test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.46.4",
    "typescript": "5.9.3"
  }
}
