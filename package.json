{
  "name": "tro",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tro/desktop tauri dev",
    "dev:web": "pnpm --filter @tro/desktop dev",
    "dev:landing": "pnpm --filter @tro/landing dev",
    "start:landing": "pnpm --filter @tro/landing start",
    "install:mac": "sh tools/install-macos-dev.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps/desktop/src apps/desktop/*.ts apps/landing/src apps/landing/*.ts",
    "typecheck": "pnpm --filter @tro/desktop typecheck",
    "typecheck:landing": "pnpm --filter @tro/landing typecheck",
    "test": "pnpm --filter @tro/desktop exec vitest",
    "build": "pnpm --filter @tro/desktop build",
    "build:landing": "pnpm --filter @tro/landing build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.46.4",
    "typescript": "5.9.3"
  }
}
